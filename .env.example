# ── PK Ninja Agent environment configuration ────────────────────────────
# Copy this file to ".env" and fill in the values. Never commit your real .env.

# GitHub integration (server-side only; never exposed to the frontend).
GITHUB_TOKEN=ghp_your_personal_access_token_here
GITHUB_OWNER=your-github-username-or-org
GITHUB_REPO=your-repo-name

# Where agent workspaces live (created per task). Defaults to ./workspaces.
WORKSPACE_ROOT=./workspaces

# SQLite database path for tasks/sessions. Defaults to ./pk_ninja.db.
DATABASE_PATH=./pk_ninja.db

# Server
HOST=0.0.0.0
PORT=8000

# ── AI provider (fully configurable via env vars) ───────────────────────
# Which provider to use:
#   local     — deterministic, offline, no API key needed (default; safe fallback)
#   openai    — any OpenAI-compatible REST endpoint (OpenAI, Gemini OpenAI-compat,
#               MiMo, DeepSeek, Together, OpenRouter, a local Ollama server, …)
#   gemini    — legacy alias; routes through Google's OpenAI-compatible endpoint
#   anthropic — native SSE Messages API adapter for Claude (Anthropic)
#   jules     — specialized adapter for Google's elite coding agent (Jules)
AI_PROVIDER=local

# API key for the chosen provider. Required for any non-local provider.
# Never exposed to the frontend. Leave empty to use the offline LocalProvider.
AI_API_KEY=

# Model name to send to the provider, e.g.:
#   openai:    gpt-4o-mini, gpt-4o
#   gemini:    gemini-2.0-flash, gemini-1.5-flash
#   deepseek:  deepseek-chat
#   ollama:    llama3, qwen2.5-coder
AI_MODEL=

# OpenAI-compatible base URL (must point at the /v1 root). Leave empty to use
# a built-in default based on AI_PROVIDER. Examples:
#   OpenAI:           https://api.openai.com/v1
#   Gemini OpenAI:    https://generativelanguage.googleapis.com/v1beta/openai/v1
#   DeepSeek:         https://api.deepseek.com/v1
#   OpenRouter:       https://openrouter.ai/api/v1
#   Ollama (local):   http://localhost:11434/v1
AI_BASE_URL=

# Sampling temperature (0.0 = deterministic, 1.0 = creative). Default 0.2.
AI_TEMPERATURE=0.2

# Request timeout for AI calls (seconds). Default 90.
AI_TIMEOUT_SECONDS=90

# ── Legacy Gemini env vars (optional; superseded by AI_* above) ─────────
# If AI_PROVIDER=gemini, these are used as a fallback when AI_API_KEY /
# AI_MODEL are empty.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Command-execution safety
COMMAND_TIMEOUT_SECONDS=30
