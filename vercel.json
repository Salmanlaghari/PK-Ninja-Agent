{
  "buildCommand": null,
  "installCommand": "pip install -r requirements.txt",
  "framework": null,
  "outputDirectory": ".",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "memory": 3009,
      "includeFiles": "backend/**,frontend/**,requirements.txt"
    }
  },
  "rewrites": [
    { "source": "/((?!.*\\.).*)", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
